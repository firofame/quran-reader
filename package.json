{
  "name": "quran-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A quiet, local-first Quran translation reader.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "check": "npm run typecheck && npm test",
    "lint": "oxlint",
    "cf-typegen": "wrangler types"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "~5.0.3",
    "wrangler": "^4.161.0"
  }
}
