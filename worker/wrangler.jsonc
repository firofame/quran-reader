{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quran-reader-sync",
  "main": "src/index.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_DO",
        "class_name": "SyncDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SyncDurableObject"]
    }
  ]
}
