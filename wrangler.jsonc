/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "quran",
	"account_id": "d2c3c656cbf2f4e32a133ab2fa3dcd5a",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": ["global_fetch_strictly_public"],
	/**
	 * The reader is a static site served by Workers Static Assets.
	 * https://developers.cloudflare.com/workers/static-assets/
	 */
	"assets": {
		// The path to the directory containing the `index.html` file to be served at `/`
		"directory": "./public",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "none"
	},
	/**
	 * The sync feature has been removed. These migrations keep the deployment
	 * history intact and delete the retired Durable Object class and its stored
	 * sync data the next time this Worker is deployed.
	 */
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["SyncDurableObject"]
		},
		{
			"tag": "v2",
			"deleted_classes": ["SyncDurableObject"]
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
